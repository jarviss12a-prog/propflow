# Copy to .env (deploy/setup.sh does this for you and fills in the secret).
# Long random string that signs your login cookie. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
PROPFLOW_SECRET_KEY=
# Where the database, receipts and backups live. Default: ./data next to this file.
# PROPFLOW_DATA=/home/you/propflow/data
# Port gunicorn listens on (localhost only; Tailscale serves it to your devices).
PORT=8050
# 1 when you reach the app over https (tailscale serve). 0 if you use http://100.x.y.z:PORT.
PROPFLOW_SECURE_COOKIES=1
# Dates like "today" and "late" follow this time zone.
PROPFLOW_TZ=America/Indiana/Indianapolis
# How many nightly backups to keep.
PROPFLOW_KEEP_BACKUPS=30
